// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  price         Float
  stockQuantity Int
  category      String
  imageUrl      String
  createdAt     DateTime @default(now())
  userId        Int
  // Set when the seller takes the listing off sale without deleting it (it may be in order history).
  archivedAt    DateTime?
  images        ListingImage[]
  // Star totals over the reviews that are not hidden; the average is ratingSum / ratingCount.
  ratingCount   Int      @default(0)
  ratingSum     Int      @default(0)
  reviews       ProductReview[]
  // Options (for example colour, then size). The product the shopper sees is the main listing. Each thing that can be
  // bought is a hidden listing of its own that points back to it with parentId: "Blue" (no sizes), or "Blue" / "M".
  // Carts, checkouts, stock, orders and refunds therefore work on these exactly as on any listing. The main listing
  // of a product with options is never bought itself.
  parentId      Int?
  optionLabel   String?
  sizeLabel     String?
  position      Int      @default(0)
  parent        Listing?  @relation("ListingOptions", fields: [parentId], references: [id], onDelete: NoAction)
  options       Listing[] @relation("ListingOptions")

  user                  User                   @relation(fields: [userId], references: [id])
  cartItems             CartItem[]
  checkoutItems         CheckoutItem[]
  orderItems            OrderItem[]
  inventoryReservations InventoryReservation[]

  @@index([userId])
  @@index([category])
  @@index([parentId])
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  // Null for an account created with Google that has not set a password yet.
  passwordHash  String?
  // Google's stable id for this person (the "sub" of their sign-in token).
  googleId      String?        @unique
  // Administrators can issue refunds. Only scripts/makeAdmin.ts sets this; registration never does.
  isAdmin       Boolean        @default(false)
  // Super administrators manage the administrator team, see the audit log and the platform figures. Only
  // scripts/makeAdmin.ts --super creates the first one; a super administrator is always also an administrator.
  isSuperAdmin  Boolean        @default(false)
  listings      Listing[]
  role          Role
  sellerProfile SellerProfile?
  cart          Cart?
  checkouts     Checkout[]
  orders        Order[]
  refundsRequested Refund[]
  liabilities   SellerLiability[]
  disputeMessages DisputeMessage[]
  decidedDisputes Dispute[]      @relation("DisputeDecidedBy")
  refreshTokens RefreshToken[]
  // Set by "log out everywhere" and password changes: access tokens issued before this stop working at once.
  sessionsValidFrom DateTime?
  // Null until the person proves they own the email (a code we email, or Google). Unverified accounts cannot log in.
  emailVerifiedAt DateTime?
  createdAt     DateTime       @default(now())
  emailOtps     EmailOtp[]
  trustedDevices TrustedDevice[]
  productReviews ProductReview[]
  shopReviews    ShopReview[]
  preOrdersAsked PreOrderRequest[] @relation("PreOrderBuyer")
  preOrdersAnswered PreOrderRequest[] @relation("PreOrderSeller")
}

enum Role {
  CONSUMER
  SELLER
}

model SellerProfile {
  id            Int     @id @default(autoincrement())
  userId        Int     @unique
  user          User    @relation(fields: [userId], references: [id])
  businessName  String
  state         String
  lga           String
  location      String
  logoUrl       String
  slug          String  @unique
  // Branding, all optional: a wide banner photo, one of the preset colours (lib/shopBranding.ts), a short "about"
  // text, social handles, and a public WhatsApp number the seller chose to show (separate from the private
  // businessPhone used for payouts).
  bannerUrl       String?
  brandColor      String  @default("forest")
  about           String?
  instagramHandle String?
  tiktokHandle    String?
  facebookHandle  String?
  xHandle         String?
  whatsappNumber  String?
  latitude      Float?
  longitude     Float?

  shippingPolicy SellerShippingPolicy
  shippingCost   Decimal?             @db.Decimal(12, 2)
  // Delivery by the buyer's state: a fee per state (or "no delivery" there) overrides the default above. When
  // deliversEverywhere is false, only the states listed in shippingRates (with a fee) can order.
  deliversEverywhere Boolean            @default(true)
  shippingRates      SellerShippingRate[]

  businessPhone         String?
  payoutTermsVersion    String?
  payoutTermsAcceptedAt DateTime?
  payoutAccounts        SellerPayoutAccount[]
  ratingCount           Int                   @default(0)
  ratingSum             Int                   @default(0)
  reviews               ShopReview[]
  // How a shop that sells food takes orders: now, only as pre-orders (the buyer asks for a time and the seller
  // approves it), or both. Every other shop is NOW.
  foodOrderType         FoodOrderType         @default(NOW)
  // Standing: complaints the seller lost count as strikes (2 in 90 days is a warning, 4 blocks new orders).
  // A blocked shop is hidden and cannot be bought from; orders already placed carry on. Lifting a block starts
  // the count again from strikesResetAt.
  blockedAt             DateTime?
  blockReason           String?
  strikeWarnedAt        DateTime?
  strikesResetAt        DateTime?
}

enum FoodOrderType {
  NOW
  PRE_ORDER
  BOTH
}

enum PayoutAccountStatus {
  PENDING
  ACTIVE
  FAILED
}

// One payout account (provider subaccount) per seller per provider. The full bank account
// number is held only by the providers; Vendly keeps the last four digits.
model SellerPayoutAccount {
  id                 Int                 @id @default(autoincrement())
  sellerProfileId    Int
  provider           PaymentProvider
  status             PayoutAccountStatus @default(PENDING)
  subaccountCode     String?
  // Flutterwave updates subaccounts by this numeric ID, not by the RS_ subaccount code.
  providerAccountId  String?
  bankId             String
  bankName           String
  accountName        String
  accountNumberLast4 String
  failureReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id])

  @@unique([sellerProfileId, provider])
  @@unique([provider, subaccountCode])
}

enum SellerShippingPolicy {
  FREE
  FIXED
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id])
  cartItems CartItem[]
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  cart      Cart    @relation(fields: [cartId], references: [id])
  listingId Int
  listing   Listing @relation(fields: [listingId], references: [id])
  quantity  Int

  @@unique([cartId, listingId])
}

enum CheckoutStatus {
  PENDING
  PAYMENT_PENDING
  COMPLETED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
}

enum InventoryReservationStatus {
  ACTIVE
  PROTECTED
  CONSUMED
  RELEASED
  EXPIRED
}

model Checkout {
  id                   Int            @id @default(autoincrement())
  userId               Int
  status               CheckoutStatus @default(PENDING)
  expiresAt            DateTime

  deliveryName         String
  deliveryPhone        String
  deliveryAddress      String
  deliveryState        String
  deliveryLga          String
  deliveryInstructions String?

  total                Decimal        @db.Decimal(12, 2)

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  user                  User                   @relation(fields: [userId], references: [id])
  checkoutItems         CheckoutItem[]
  orders                Order[]
  paymentAttempts       PaymentAttempt[]
  inventoryReservations InventoryReservation[]

  @@index([userId])
}

model CheckoutItem {
  id         Int     @id @default(autoincrement())
  checkoutId Int
  listingId  Int

  title      String
  unitPrice  Decimal @db.Decimal(12, 2)
  quantity   Int

  checkout Checkout @relation(fields: [checkoutId], references: [id])
  listing  Listing  @relation(fields: [listingId], references: [id])

  @@unique([checkoutId, listingId])
  @@index([listingId])
}

model InventoryReservation {
  id         Int                       @id @default(autoincrement())
  checkoutId Int
  listingId  Int
  quantity   Int
  status     InventoryReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  checkout Checkout @relation(fields: [checkoutId], references: [id])
  listing  Listing  @relation(fields: [listingId], references: [id])

  @@unique([checkoutId, listingId])
  @@index([listingId, status])
  @@index([expiresAt])
}

model Order {
  id           Int         @id @default(autoincrement())
  checkoutId   Int
  sellerId     Int
  status       OrderStatus @default(PENDING_PAYMENT)

  subtotal     Decimal @db.Decimal(12, 2)
  shippingCost Decimal @db.Decimal(12, 2)
  total        Decimal @db.Decimal(12, 2)
  // What the payment provider reported for this seller's share when the order was paid: the fee
  // taken from it and the amount paid out to the seller. Null when the provider did not report it.
  providerFee    Decimal? @db.Decimal(12, 2)
  sellerReceives Decimal? @db.Decimal(12, 2)
  // Total of this order's refunds that have completed.
  refundedAmount Decimal  @default(0) @db.Decimal(12, 2)
  // Part of this order's total that Vendly keeps to recover what the seller owes for earlier refunds.
  // Planned when payment starts, then set to what Vendly actually received once the payment settles.
  liabilityDeduction Decimal @default(0) @db.Decimal(12, 2)

  // Fulfilment. The seller reports shipping and delivery; only the buyer's confirmation makes an order
  // DELIVERED. deliveryReportedAt is the seller saying it was delivered (status stays SHIPPED until the
  // buyer confirms); deliveryConfirmedAt is the buyer confirming it.
  shippedAt           DateTime?
  shippingNote        String?
  deliveryReportedAt  DateTime?
  deliveryConfirmedAt DateTime?
  // The buyer is reminded 4 days after the seller reports delivery; at 7 days, with no answer and no open
  // complaint, the order is closed as delivered automatically. That is not the buyer's confirmation.
  deliveryReminderSentAt DateTime?
  deliveryAutoClosedAt   DateTime?

  // NOW, or PRE_ORDER: the buyer asked for it on readyAt and the seller approved. For a pre-order the complaint
  // periods count from readyAt (if later than payment) instead of from payment.
  fulfilmentType   FulfilmentType @default(NOW)
  readyAt          DateTime?
  preOrderRequestId Int?
  preOrderRequest  PreOrderRequest? @relation(fields: [preOrderRequestId], references: [id])

  deliveryName         String
  deliveryPhone        String
  deliveryAddress      String
  deliveryState        String
  deliveryLga          String
  deliveryInstructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkout   Checkout    @relation(fields: [checkoutId], references: [id])
  seller     User        @relation(fields: [sellerId], references: [id])
  orderItems OrderItem[]
  refunds    Refund[]
  liabilityRecoveries LiabilityRecovery[]
  disputes   Dispute[]
  productReviews ProductReview[]
  shopReviews    ShopReview[]

  @@index([sellerId, status])
  @@index([preOrderRequestId])
  @@index([checkoutId])
  @@index([status])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  listingId Int

  title     String
  unitPrice Decimal @db.Decimal(12, 2)
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])

  @@index([listingId])
}

model PaymentAttempt {
  id          Int             @id @default(autoincrement())
  checkoutId  Int
  provider    PaymentProvider
  // Vendly's reference, created before the provider is called (Paystack reference, Flutterwave tx_ref).
  reference   String          @unique
  providerRef String?
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("NGN")
  status      PaymentStatus   @default(PENDING)

  providerTransactionId String?
  authorizationUrl      String?
  // The provider's own status word from the latest check, kept for support and reconciliation.
  providerStatus        String?
  failureReason         String?
  lastCheckedAt         DateTime?
  verifiedAt            DateTime?
  // Each subaccount's fee and payout as the provider reported them at verification, in kobo:
  // [{ subaccountCode, feeKobo, receivedKobo }]. Copied onto the seller orders at settlement.
  sellerShares          Json?
  // What the provider reported as Vendly's own share of the split, in kobo (null if not reported).
  vendlyShareKobo       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkout     Checkout             @relation(fields: [checkoutId], references: [id])
  recoveryCase PaymentRecoveryCase?
  refunds      Refund[]

  @@unique([provider, providerRef])
  @@index([checkoutId])
}

enum DisputeReason {
  NOT_RECEIVED
  NOT_AS_DESCRIBED
  DAMAGED
  WRONG_ITEM
  OTHER
  SELLER_REFUND_OFFER
}

enum DisputeStatus {
  OPEN
  SELLER_AGREED
  UNDER_REVIEW
  RESOLVED
  WITHDRAWN
}

enum DisputeOutcome {
  REFUNDED
  REJECTED
}

// Who opened a complaint or wrote a message. SYSTEM is Vendly's own notes ("passed to Vendly for a decision").
enum DisputeParty {
  BUYER
  SELLER
  ADMIN
  SYSTEM
}

// A buyer's complaint about one seller order, or a refund a seller offers. The buyer and seller write
// to one shared thread; only an administrator decides, and an approved complaint becomes a refund.
//   OPEN: waiting for the seller (who has until responseDueAt)
//   SELLER_AGREED: the seller agrees to the refund; waiting for an administrator to approve it
//   UNDER_REVIEW: the seller disagreed or did not answer in time; waiting for an administrator
//   RESOLVED: refunded or rejected     WITHDRAWN: taken back by whoever opened it
model Dispute {
  id                Int            @id @default(autoincrement())
  orderId           Int
  openedBy          DisputeParty
  reason            DisputeReason
  requestedAmount   Decimal        @db.Decimal(12, 2)
  status            DisputeStatus  @default(OPEN)
  outcome           DisputeOutcome?
  approvedAmount    Decimal?       @db.Decimal(12, 2)
  decisionNote      String?
  decidedById       Int?
  responseDueAt     DateTime
  sellerRespondedAt DateTime?
  // Set when the seller agreed to the refund. A refund the seller agreed to is not a strike against them.
  sellerAgreedAt    DateTime?
  escalatedAt       DateTime?
  resolvedAt        DateTime?
  // When the buyer and the seller last opened the complaint; messages by others after this are "new" to them.
  buyerReadAt        DateTime?
  sellerReadAt       DateTime?
  // Set when the buyer appealed Vendly's rejection. A rejection can be appealed once; the second decision is final.
  appealedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order     Order            @relation(fields: [orderId], references: [id])
  decidedBy User?            @relation("DisputeDecidedBy", fields: [decidedById], references: [id])
  messages  DisputeMessage[]
  refunds   Refund[]

  @@index([orderId])
  @@index([status, responseDueAt])
}

model DisputeMessage {
  id           Int          @id @default(autoincrement())
  disputeId    Int
  author       DisputeParty
  authorId     Int?
  body         String
  // Links to photos or documents the sender uploaded, as a JSON list of https addresses.
  evidenceUrls Json         @default("[]")
  createdAt    DateTime     @default(now())

  dispute    Dispute @relation(fields: [disputeId], references: [id])
  authorUser User?   @relation(fields: [authorId], references: [id])

  @@index([disputeId])
}

enum RefundStatus {
  PENDING
  PROCESSING
  NEEDS_ATTENTION
  SUCCEEDED
  FAILED
}

// A refund to a buyer through the provider that took the payment. A refund covers one seller's order,
// or (for a recovery case) a whole payment. The provider accepting the request is not proof it
// completed: the status follows the provider's own refund status.
model Refund {
  id               Int             @id @default(autoincrement())
  orderId          Int?
  paymentAttemptId Int
  provider         PaymentProvider
  // Vendly's own reference, created before the provider is called.
  reference        String          @unique
  amount           Decimal         @db.Decimal(12, 2)
  currency         String          @default("NGN")
  status           RefundStatus    @default(PENDING)
  // Shown to the seller if they are charged for this refund.
  reason           String
  // Shown to the buyer.
  customerNote     String?
  restock          Boolean         @default(false)
  chargeSeller     Boolean         @default(true)
  providerRefundId String?
  providerStatus   String?
  // True while the provider is waiting for Vendly's balance to cover the refund.
  awaitingFunds    Boolean         @default(false)
  expectedAt       DateTime?
  failureReason    String?
  requestedById    Int
  // The complaint this refund settles, when it came from one.
  disputeId        Int?
  restockedAt      DateTime?
  lastCheckedAt    DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  order          Order?          @relation(fields: [orderId], references: [id])
  paymentAttempt PaymentAttempt  @relation(fields: [paymentAttemptId], references: [id])
  requestedBy    User            @relation(fields: [requestedById], references: [id])
  dispute        Dispute?        @relation(fields: [disputeId], references: [id])
  liability      SellerLiability?

  @@unique([provider, providerRefundId])
  @@index([orderId])
  @@index([paymentAttemptId])
  @@index([status])
  @@index([disputeId])
}

enum LiabilityStatus {
  OPEN
  CLEARED
  WRITTEN_OFF
  VOID
}

// What a seller owes Vendly because Vendly refunded a buyer for their order. It is recovered from the
// seller's future payments (and by hand where that is not possible), never by taking money from
// their bank account. Vendly never deducts it without the seller having accepted the terms.
model SellerLiability {
  id          Int             @id @default(autoincrement())
  sellerId    Int
  refundId    Int             @unique
  amount      Decimal         @db.Decimal(12, 2)
  recovered   Decimal         @default(0) @db.Decimal(12, 2)
  status      LiabilityStatus @default(OPEN)
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  closedAt    DateTime?

  seller     User                @relation(fields: [sellerId], references: [id])
  refund     Refund              @relation(fields: [refundId], references: [id])
  recoveries LiabilityRecovery[]

  @@index([sellerId, status])
}

// Money taken against a liability: from one of the seller's later orders, or recorded by hand
// (orderId is null for a manual recovery).
model LiabilityRecovery {
  id          Int      @id @default(autoincrement())
  liabilityId Int
  orderId     Int?
  amount      Decimal  @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime @default(now())

  liability SellerLiability @relation(fields: [liabilityId], references: [id])
  order     Order?          @relation(fields: [orderId], references: [id])

  @@unique([liabilityId, orderId])
  @@index([orderId])
}

enum PaymentRecoveryStatus {
  OPEN
  RESOLVED
}

// A verified payment Vendly could not complete automatically, for example one that arrived after
// the checkout's stock was released. Each needs a person to fulfil or refund it.
model PaymentRecoveryCase {
  id               Int                   @id @default(autoincrement())
  paymentAttemptId Int                   @unique
  reason           String
  status           PaymentRecoveryStatus @default(OPEN)
  resolutionNote   String?
  createdAt        DateTime              @default(now())
  resolvedAt       DateTime?

  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id])
}

// One row per provider webhook event, so redelivered events are recognised and not processed
// twice. Only what is needed for deduplication and support is kept, never card or customer details.
model PaymentEvent {
  id          Int             @id @default(autoincrement())
  provider    PaymentProvider
  eventKey    String
  eventType   String
  reference   String?
  receivedAt  DateTime        @default(now())
  processedAt DateTime?

  @@unique([provider, eventKey])
  @@index([reference])
}

// A login on one device. The browser holds a random secret; only its hash is stored. Each use swaps it
// for a new one (same family, same fixed expiry). Using an old one again revokes the whole family.
model RefreshToken {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId      String
  tokenHash     String    @unique
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  // ROTATED, LOGOUT, LOGOUT_ALL or REUSE
  revokedReason String?

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

enum OtpPurpose {
  VERIFY_EMAIL
  LOGIN
  PASSWORD_RESET
  GOOGLE_LINK
  SET_PASSWORD
}

// A one-time code we email. Only a keyed hash of the code is stored.
model EmailOtp {
  id         Int        @id @default(autoincrement())
  userId     Int
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

// A browser that proved itself with a code, so later logins from it skip the code until it expires.
model TrustedDevice {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

// One photo of a listing. position 0 is the first, which cards show (and Listing.imageUrl repeats).
model ListingImage {
  id        Int      @id @default(autoincrement())
  listingId Int
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  position  Int
  createdAt DateTime @default(now())

  @@unique([listingId, position])
}

// A buyer's review of a product they received: 1 to 5 stars and an optional comment. One per buyer per product.
// A hidden review (hiddenAt set by an administrator) is not shown and does not count in the rating.
model ProductReview {
  id           Int       @id @default(autoincrement())
  listingId    Int
  listing      Listing   @relation(fields: [listingId], references: [id])
  buyerId      Int
  buyer        User      @relation(fields: [buyerId], references: [id])
  // The delivered order that made this buyer able to review.
  orderId      Int
  order        Order     @relation(fields: [orderId], references: [id])
  rating       Int
  comment      String?
  // Up to 3 photos of what arrived (https links from the upload flow). Hidden with the review.
  photoUrls    String[]  @default([])
  hiddenAt     DateTime?
  hiddenReason String?
  hiddenById   Int?
  // The seller can report a review that breaks the rules; an administrator decides whether to hide it.
  reportedAt   DateTime?
  reportReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([buyerId, listingId])
  @@index([listingId, hiddenAt, createdAt])
  @@index([orderId])
}

// The same for a shop: one per buyer per shop.
model ShopReview {
  id              Int           @id @default(autoincrement())
  sellerProfileId Int
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id])
  buyerId         Int
  buyer           User          @relation(fields: [buyerId], references: [id])
  orderId         Int
  order           Order         @relation(fields: [orderId], references: [id])
  rating          Int
  comment         String?
  // Up to 3 photos of what arrived (https links from the upload flow). Hidden with the review.
  photoUrls       String[]      @default([])
  hiddenAt        DateTime?
  hiddenReason    String?
  hiddenById      Int?
  reportedAt      DateTime?
  reportReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([buyerId, sellerProfileId])
  @@index([sellerProfileId, hiddenAt, createdAt])
  @@index([orderId])
}

enum FulfilmentType {
  NOW
  PRE_ORDER
}

enum PreOrderStatus {
  REQUESTED
  APPROVED
  DECLINED
  EXPIRED
  CANCELLED
  USED
}

// A buyer asking a food shop to have their cart ready at a time of their choosing. The seller approves or
// declines; an approved request lets the buyer pay for exactly those items, and the paid order carries the
// ready time. Nothing is charged until the buyer pays after approval.
model PreOrderRequest {
  id         Int            @id @default(autoincrement())
  buyerId    Int
  buyer      User           @relation("PreOrderBuyer", fields: [buyerId], references: [id])
  sellerId   Int
  seller     User           @relation("PreOrderSeller", fields: [sellerId], references: [id])
  readyAt    DateTime
  // A message from the buyer to the seller (for example what it is for).
  note       String?
  status     PreOrderStatus @default(REQUESTED)
  // The cart lines this request is for, as they were when it was asked: [{ listingId, quantity, unitPrice }].
  items      Json
  sellerNote String?
  // The seller must answer by this time or the request lapses.
  respondBy  DateTime
  decidedAt  DateTime?
  // After approval, the buyer must pay by this time.
  payBy      DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  orders Order[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status, respondBy])
}

// What administrators did to accounts, kept even if an account is later deleted (so the people are plain ids, not
// relations). Only super administrators can read it.
model AdminAuditLog {
  id           Int      @id @default(autoincrement())
  actorId      Int
  action       String
  targetUserId Int?
  detail       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// A seller's delivery fee for one Nigerian state. A null cost means the seller does not deliver there.
model SellerShippingRate {
  id              Int           @id @default(autoincrement())
  sellerProfileId Int
  state           String
  cost            Decimal?      @db.Decimal(12, 2)
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@unique([sellerProfileId, state])
}
