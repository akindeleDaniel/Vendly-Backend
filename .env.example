# Copy this file to .env and fill in real values. Never commit .env.

# Required: the server refuses to start without these.
DATABASE_URL=postgresql://YOUR_LOCAL_POSTGRES_USER:YOUR_LOCAL_POSTGRES_PASSWORD@localhost:5432/vendly?schema=public
JWT_SECRET=replace-with-a-long-random-secret

# Optional: geocoding and driving distances for shop discovery. Features degrade gracefully without it.
GEOAPIFY_API_KEY=

# Optional deployment settings. The defaults shown suit local development.
PORT=3000
# Frontend origin only (no path). Used for CORS.
FRONTEND_URL=http://localhost:5173
# Login cookie SameSite: lax, strict or none. Use none (forces Secure) only if the frontend
# and API are served from different sites.
COOKIE_SAME_SITE=lax

# Payment providers (test keys in development: sk_test_... and FLWSECK_TEST-...).
# Only needed for seller payout setup and payments; never commit real keys.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# The secret hash you set in the Flutterwave dashboard (Settings > Webhooks); Flutterwave sends it
# in the verif-hash header of each webhook.
FLUTTERWAVE_WEBHOOK_SECRET=
