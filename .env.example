# Copy this file to .env and fill in real values. Never commit .env.

# Required: the server refuses to start without these.
DATABASE_URL=postgresql://YOUR_LOCAL_POSTGRES_USER:YOUR_LOCAL_POSTGRES_PASSWORD@localhost:5432/vendly?schema=public
JWT_SECRET=replace-with-a-long-random-secret

# Optional: geocoding and driving distances for shop discovery. Features degrade gracefully without it.
GEOAPIFY_API_KEY=

# Optional deployment settings. The defaults shown suit local development.
PORT=3000
# Frontend origin only (no path). Used for CORS.
FRONTEND_URL=http://localhost:5173
# Login cookie SameSite: lax, strict or none. Use none (forces Secure) only if the frontend
# and API are served from different sites.
COOKIE_SAME_SITE=lax

# How many proxies (load balancer, the host's router) sit in front of this server: 0 for none, usually 1 on a host.
# Needed so rate limiting sees the real visitor address. Required in production; never set it to "true".
TRUST_PROXY=0

# Payment providers (test keys in development: sk_test_... and FLWSECK_TEST-...).
# Only needed for seller payout setup and payments; never commit real keys.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# The secret hash you set in the Flutterwave dashboard (Settings > Webhooks); Flutterwave sends it
# in the verif-hash header of each webhook.
FLUTTERWAVE_WEBHOOK_SECRET=

# Email (login codes, sign-up confirmation, password reset).
# EMAIL_MODE=console prints emails in the server console instead of sending them (development only; refused in production).
# EMAIL_MODE=smtp sends through an SMTP provider. For development, Gmail works with an "app password"
# (Google account > Security > 2-Step Verification > App passwords): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587.
EMAIL_MODE=console
EMAIL_FROM=Vendly <no-reply@your-domain.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Google sign-in (Google Cloud console > Google Auth Platform > Clients > Web application). Client ID only, never the secret.
GOOGLE_CLIENT_ID=

# Limits that cap what one bad seller can cost while the platform has no income of its own (whole naira; 0 switches a limit off).
# MAX_ORDER_VALUE: the most one seller's order may be worth. SELLER_DEBT_LIMIT: the most a seller may owe for refunds that
# were charged to them; above it the seller takes no new orders until it is repaid.
MAX_ORDER_VALUE=100000
SELLER_DEBT_LIMIT=50000
